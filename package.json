{
  "name": "dialectseed",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --config wrangler.toml",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:worker": "wrangler deploy --config wrangler.toml",
    "deploy:pages": "wrangler pages deploy dist --project-name dialectseed --branch production",
    "db:migrate:local": "wrangler d1 execute your-d1-database --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute your-d1-database --remote --file=./schema.sql",
    "db:migrate:v2:local": "wrangler d1 execute your-d1-database --local --file=./migrations/0002_multivariety.sql",
    "db:migrate:v2:remote": "wrangler d1 execute your-d1-database --remote --file=./migrations/0002_multivariety.sql",
    "dataset:export": "node scripts/export-dataset.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "wrangler": "^4.48.0"
  }
}
